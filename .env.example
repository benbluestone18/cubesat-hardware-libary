# Copy to .env.local. From Supabase: Project Settings > API (or `npx supabase status` for local).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The site's own address. Set this on Vercel to your production URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Email links are how people sign in. Production needs your own email sender in Supabase (custom SMTP).
NEXT_PUBLIC_EMAIL_SIGNIN=on
# "on" shows Continue with Google. Leave it off until the school's Google Workspace admin allows the app.
NEXT_PUBLIC_GOOGLE_SIGNIN=off
