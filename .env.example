# Copy to .env.local. From Supabase: Project Settings > API (or `npx supabase status` for local).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The site's own address. Set this on Vercel to your production URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# "on" shows the email-link sign-in. Keep it off in production unless you set up your own email sender in Supabase.
NEXT_PUBLIC_EMAIL_SIGNIN=off
